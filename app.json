{
  "expo": {
    "name": "Parkside",
    "slug": "parkside",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a3a2f"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.parkside.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a3a2f"
      },
      "package": "com.parkside.app"
    }
  }
}
